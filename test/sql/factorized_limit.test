# name: test/sql/factorized_limit.test
# description: count(*) over LIMIT k -- which is the shape EXISTS is planned into
# group: [sql]

require factorize

# Every expected value here is also what stock DuckDB produces with the rule
# switched off. The answer to count(*) over `LIMIT k` is min(k, |join|), and it
# is well defined even though *which* k tuples the limit keeps is not: no ORDER
# BY means no order, so the only thing both plans must agree on is how many.

statement ok
CREATE TABLE r AS SELECT i % 10 AS s, i AS d FROM range(100) t(i);

statement ok
CREATE TABLE s AS SELECT i % 10 AS s, i AS d FROM range(100) t(i);

# 10 keys, 10 rows each side: 10 * 10 * 10 = 1000 tuples.
query I
SELECT count(*) FROM r, s WHERE r.s = s.s;
----
1000

statement ok
SET factorize_mode = 'force';

#-----------------------------------------------------------------------------
# EXISTS, which is why this exists.
#-----------------------------------------------------------------------------

# DuckDB plans EXISTS as count(*) over a constant projection over LIMIT 1 over
# the join. Before the LIMIT was matched, the rule declined the whole of it with
# "not a scan: LIMIT" and every EXISTS went to the stock plan.
query I
SELECT EXISTS (SELECT * FROM r, s WHERE r.s = s.s);
----
true

query II
EXPLAIN SELECT EXISTS (SELECT * FROM r, s WHERE r.s = s.s);
----
physical_plan	<REGEX>:.*FACTORIZED.*

# The operator says what it was asked for, or a plan that stops early is
# indistinguishable from one that did the whole job.
query II
EXPLAIN SELECT EXISTS (SELECT * FROM r, s WHERE r.s = s.s);
----
physical_plan	<REGEX>:.*Counts At Most.*1.*

# A join with no tuples has to answer no -- and that is the case where every
# bucket of the partition is examined, since none of them can end the search.
statement ok
CREATE TABLE disjoint AS SELECT 999 AS s, 1 AS d;

query I
SELECT EXISTS (SELECT * FROM r, disjoint WHERE r.s = disjoint.s);
----
false

# WHERE EXISTS, the other way a user writes it: the same count, compared to
# zero one operator further up.
query I
SELECT count(*) FROM (SELECT 1 WHERE EXISTS (SELECT * FROM r, s WHERE r.s = s.s)) q;
----
1

query I
SELECT count(*) FROM (SELECT 1 WHERE EXISTS (SELECT * FROM r, disjoint WHERE r.s = disjoint.s)) q;
----
0

#-----------------------------------------------------------------------------
# The general limit: min(k, |join|), on both sides of the join's own size.
#-----------------------------------------------------------------------------

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3) q;
----
3

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 999) q;
----
999

# At the join's own size, and past it: asking for more tuples than exist is
# answered with how many exist, not with what was asked for.
query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 1000) q;
----
1000

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 5000) q;
----
1000

# LIMIT 0 keeps nothing, and must not read the input to find that out.
query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 0) q;
----
0

# An empty join under a limit is the join's size, not the limit.
query I
SELECT count(*) FROM (SELECT * FROM r, disjoint WHERE r.s = disjoint.s LIMIT 10) q;
----
0

#-----------------------------------------------------------------------------
# Shapes the limit must be declined for. Each still has to answer correctly,
# because a decline leaves the stock plan in place.
#-----------------------------------------------------------------------------

# An OFFSET makes the answer clamp(N - m, 0, k), and N is the number this path
# exists in order not to compute.
query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3 OFFSET 998) q;
----
2

query II
EXPLAIN SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3 OFFSET 998) q;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

# Which k tuples a limit keeps is undefined, so a fold that reads their values
# has no single right answer to agree with. sum() over a limit is declined.
query II
EXPLAIN SELECT sum(q.d) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3) q;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

# Same reason, one aggregate along: a count per group counts a set nobody
# specified.
query II
EXPLAIN SELECT q.s, count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3) q GROUP BY q.s;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

# A percentage needs the join's size, which is the same objection as OFFSET.
query II
EXPLAIN SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 10%) q;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 10%) q;
----
100

#-----------------------------------------------------------------------------
# Under 'auto' it does not fire, and that is a measurement rather than a
# shortcoming of the matcher.
#
# Rewritten as EXISTS, all 119 runnable CE queries agreed with stock and 93 were
# slower, because DuckDB stops its probe at the first tuple while this stops at
# the first non-empty bucket of the join key (D53). The shape is matched, tested
# and correct; what it waits for is something that can tell the 2.5x win on
# epinions from the 33x loss on watdiv.
#-----------------------------------------------------------------------------

# Big enough that the gate takes the plain count, so what declines the EXISTS
# below is the limit and not the size.
statement ok
CREATE TABLE big_a AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
CREATE TABLE big_b AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
CREATE TABLE big_c AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
SET factorize_mode = 'auto';

query II
EXPLAIN SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# The same join, asked for a witness instead of a count: declined.
query II
EXPLAIN SELECT EXISTS (SELECT * FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k);
----
physical_plan	<!REGEX>:.*FACTORIZED.*

query I
SELECT EXISTS (SELECT * FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k);
----
true

# And the setting turns it on for anyone whose data says otherwise.
statement ok
SET factorize_limit = true;

query II
EXPLAIN SELECT EXISTS (SELECT * FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k);
----
physical_plan	<REGEX>:.*FACTORIZED.*

query I
SELECT EXISTS (SELECT * FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k);
----
true

statement ok
SET factorize_limit = false;

#-----------------------------------------------------------------------------
# The answers do not depend on the rule being on.
#-----------------------------------------------------------------------------

statement ok
SET factorize_mode = 'off';

query I
SELECT EXISTS (SELECT * FROM r, s WHERE r.s = s.s);
----
true

query I
SELECT EXISTS (SELECT * FROM r, disjoint WHERE r.s = disjoint.s);
----
false

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 3) q;
----
3

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 5000) q;
----
1000

query I
SELECT count(*) FROM (SELECT * FROM r, s WHERE r.s = s.s LIMIT 0) q;
----
0
