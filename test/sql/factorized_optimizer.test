# name: test/sql/factorized_optimizer.test
# description: The optimizer rule computes real counts, and every answer matches factorize_mode='off'
# group: [sql]

require factorize

# Every expected value below is also the value stock DuckDB produces with the
# rule switched off: the rule is a drop-in replacement or it is a bug. Shapes
# the matcher declines are here for the same reason -- a decline has to leave
# the right answer behind, not merely avoid firing.

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES (1), (1), (2), (3)) t(x);

statement ok
CREATE TABLE s AS SELECT * FROM (VALUES (1), (2), (2), (4)) t(x);

# x=1: 2*1, x=2: 1*2, x=3 and x=4 join with nothing.
query I
SELECT count(*) FROM r, s WHERE r.x = s.x;
----
4

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM r, s WHERE r.x = s.x;
----
4

# ... and the operator is the one that answered.
query II
EXPLAIN SELECT count(*) FROM r, s WHERE r.x = s.x;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# EXPLAIN has to say what was taken over, or a silent rewrite is undebuggable.
query II
EXPLAIN SELECT count(*) FROM r, s WHERE r.x = s.x;
----
physical_plan	<REGEX>:.*(r.x = s.x|s.x = r.x).*

#-----------------------------------------------------------------------------
# Shapes the region is for.
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE hub AS SELECT * FROM (VALUES (1), (1), (2)) t(k);

statement ok
CREATE TABLE arm1 AS SELECT * FROM (VALUES (1), (1), (1), (2)) t(k);

statement ok
CREATE TABLE arm2 AS SELECT * FROM (VALUES (1), (2), (2)) t(k);

# Star. k=1: 2*3*1 = 6, k=2: 1*1*2 = 2.
statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM hub, arm1, arm2 WHERE hub.k = arm1.k AND hub.k = arm2.k;
----
8

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM hub, arm1, arm2 WHERE hub.k = arm1.k AND hub.k = arm2.k;
----
8

# Equality propagation: the same star written as a chain of predicates must give
# the same answer, because the two predicates put all three in one class.
query I
SELECT count(*) FROM hub, arm1, arm2 WHERE hub.k = arm1.k AND arm1.k = arm2.k;
----
8

statement ok
CREATE TABLE chain_a AS SELECT * FROM (VALUES (1), (2)) t(x);

statement ok
CREATE TABLE chain_b AS SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) t(x, y);

statement ok
CREATE TABLE chain_c AS SELECT * FROM (VALUES (10), (10), (30)) t(y);

# Chain: (1,10) matches two c rows, (1,20) none, (2,30) one.
statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM chain_a, chain_b, chain_c WHERE chain_a.x = chain_b.x AND chain_b.y = chain_c.y;
----
3

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM chain_a, chain_b, chain_c WHERE chain_a.x = chain_b.x AND chain_b.y = chain_c.y;
----
3

# Self-join: two scans of one table, which is the case relation identity has to
# get right. Paths of length two in 1->2, 1->3, 2->3, 3->1.
statement ok
CREATE TABLE edge AS SELECT * FROM (VALUES (1, 2), (1, 3), (2, 3), (3, 1)) t(src, dst);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM edge e1, edge e2 WHERE e1.dst = e2.src;
----
5

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM edge e1, edge e2 WHERE e1.dst = e2.src;
----
5

# A self-join's EXPLAIN has to distinguish the two scans of the one table.
query II
EXPLAIN SELECT count(*) FROM edge e1, edge e2 WHERE e1.dst = e2.src;
----
physical_plan	<REGEX>:.*edge#1.*

# A triangle cannot be arranged as an f-tree at all: its third relation reaches
# the other two through two different equivalence classes, so its keys never
# land on one level. The planner refuses it, which has to show up as the stock
# plan answering -- not as a query that dies partway through.
statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM edge a, edge b, edge c WHERE a.dst = b.src AND b.dst = c.src AND c.dst = a.src;
----
3

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM edge a, edge b, edge c WHERE a.dst = b.src AND b.dst = c.src AND c.dst = a.src;
----
3

query II
EXPLAIN SELECT count(*) FROM edge a, edge b, edge c WHERE a.dst = b.src AND b.dst = c.src AND c.dst = a.src;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

#-----------------------------------------------------------------------------
# NULLs and widths, the two places the table function had live bugs.
#-----------------------------------------------------------------------------

# A NULL join key equals nothing, including another NULL. A relation with two
# join columns is the case that broke: dropping NULLs per column rather than per
# row desynchronises the columns and fabricates rows that never existed.
statement ok
CREATE TABLE holes AS SELECT * FROM (VALUES (1, 1), (NULL, 2), (3, NULL), (2, 2)) t(p, q);

statement ok
CREATE TABLE keys1 AS SELECT * FROM (VALUES (1), (2), (3)) t(k);

statement ok
CREATE TABLE keys2 AS SELECT * FROM (VALUES (1), (2)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM holes, keys1, keys2 WHERE holes.p = keys1.k AND holes.q = keys2.k;
----
2

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM holes, keys1, keys2 WHERE holes.p = keys1.k AND holes.q = keys2.k;
----
2

# Keys past int32. Two BIGINTs sharing their low 32 bits must stay distinct --
# truncating them into a signed 32-bit slot merges them silently.
statement ok
CREATE TABLE wide_l AS SELECT * FROM (VALUES (4294967296), (1)) t(k);

statement ok
CREATE TABLE wide_r AS SELECT * FROM (VALUES (4294967296), (4294967296), (1)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM wide_l, wide_r WHERE wide_l.k = wide_r.k;
----
3

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM wide_l, wide_r WHERE wide_l.k = wide_r.k;
----
3

# Mixed widths across one edge.
statement ok
CREATE TABLE narrow AS SELECT CAST(k AS INTEGER) AS k FROM (VALUES (1), (2), (2)) t(k);

statement ok
CREATE TABLE wide AS SELECT CAST(k AS BIGINT) AS k FROM (VALUES (2), (3)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM narrow, wide WHERE narrow.k = wide.k;
----
2

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM narrow, wide WHERE narrow.k = wide.k;
----
2

# An empty relation empties the whole region.
statement ok
CREATE TABLE nothing (k INTEGER);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM r, nothing WHERE r.x = nothing.k;
----
0

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM r, nothing WHERE r.x = nothing.k;
----
0

#-----------------------------------------------------------------------------
# Filters. The region replaces the plan's scans, so a filter it dropped would
# not be applied by anything -- these count the filtered join or they are a
# wrong answer, not a slow one.
#-----------------------------------------------------------------------------

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x = 1;
----
2

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND s.x > 1;
----
2

# The filtered column is not a join key here, so it is read only to be filtered.
query I
SELECT count(*) FROM chain_a, chain_b WHERE chain_a.x = chain_b.x AND chain_b.y > 15;
----
2

# A filter that removes everything.
query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x = 99;
----
0

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x = 1;
----
2

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND s.x > 1;
----
2

query I
SELECT count(*) FROM chain_a, chain_b WHERE chain_a.x = chain_b.x AND chain_b.y > 15;
----
2

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x = 99;
----
0

# A range. DuckDB's statistics propagation writes two-sided ranges as BETWEEN,
# and it is the commonest thing left above a scan on a real join plan.
statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM chain_a, chain_b WHERE chain_a.x = chain_b.x AND chain_b.y BETWEEN 15 AND 35;
----
2

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x >= 1 AND r.x <= 1;
----
2

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM chain_a, chain_b WHERE chain_a.x = chain_b.x AND chain_b.y BETWEEN 15 AND 35;
----
2

query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND r.x >= 1 AND r.x <= 1;
----
2

# An OR cannot become a per-column filter set, whose members are ANDed, so this
# declines -- and the stock plan still answers.
query I
SELECT count(*) FROM r, s WHERE r.x = s.x AND (r.x = 1 OR r.x = 2);
----
4

# A filter on a non-integer column is fine as long as the join keys are
# integers: it is scanned to be filtered, never packed into a slot.
statement ok
CREATE TABLE labelled AS SELECT * FROM (VALUES (1, 'keep'), (2, 'drop'), (2, 'keep')) t(k, tag);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM labelled, s WHERE labelled.k = s.x AND labelled.tag = 'keep';
----
3

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM labelled, s WHERE labelled.k = s.x AND labelled.tag = 'keep';
----
3

#-----------------------------------------------------------------------------
# Declines. Each has to leave the correct answer behind.
#-----------------------------------------------------------------------------

statement ok
SET factorize_mode = 'force';

# Non-integer join keys have no fixed-width slot.
statement ok
CREATE TABLE words_l AS SELECT * FROM (VALUES ('a'), ('b')) t(w);

statement ok
CREATE TABLE words_r AS SELECT * FROM (VALUES ('a'), ('a')) t(w);

query I
SELECT count(*) FROM words_l, words_r WHERE words_l.w = words_r.w;
----
2

# An outer join is not an inner one.
query I
SELECT count(*) FROM r LEFT JOIN s ON r.x = s.x;
----
5

# An inequality is not an equality.
query I
SELECT count(*) FROM r, s WHERE r.x < s.x;
----
8

# GROUP BY is not the sealed island's shape.
query II
SELECT r.x, count(*) FROM r, s WHERE r.x = s.x GROUP BY r.x ORDER BY r.x;
----
1	2
2	2

# Only COUNT(*) is a v1 aggregate.
query I
SELECT sum(r.x) FROM r, s WHERE r.x = s.x;
----
6

query I
SELECT count(DISTINCT r.x) FROM r, s WHERE r.x = s.x;
----
2

# One relation has nothing to factorize.
query I
SELECT count(*) FROM r;
----
4

# A cross product is a disconnected graph, which the join order refuses.
query I
SELECT count(*) FROM r, s;
----
16

# Not a stored table: nothing to re-scan.
query I
SELECT count(*) FROM range(4) t(x), s WHERE t.x = s.x;
----
3

# A computed join key is not a bare column reference.
query I
SELECT count(*) FROM r, s WHERE r.x + 1 = s.x;
----
5

#-----------------------------------------------------------------------------
# The region is sealed: it has to compose with whatever surrounds it.
#-----------------------------------------------------------------------------

query I
SELECT (SELECT count(*) FROM r, s WHERE r.x = s.x) * 2;
----
8

query I
SELECT count(*) FROM r, s WHERE r.x = s.x HAVING count(*) > 3;
----
4

# A factorizable region nested under a shape that is not factorizable itself.
query II
SELECT k, cnt FROM (SELECT 1 AS k, count(*) AS cnt FROM r, s WHERE r.x = s.x) t;
----
1	4

#-----------------------------------------------------------------------------
# Declines have to be askable-about. The rule turns queries down constantly and
# silently by design, so without this the symptom of a broken matcher is nothing
# happening -- which is also the symptom of a correctly conservative one.
#-----------------------------------------------------------------------------

statement ok
SET factorize_explain = true;

statement ok
SELECT count(*) FROM r, s WHERE r.x = s.x;

statement ok
SELECT count(*) FROM words_l, words_r WHERE words_l.w = words_r.w;

statement ok
SET factorize_explain = false;

#-----------------------------------------------------------------------------
# The modes still mean what they say.
#-----------------------------------------------------------------------------

# AUTO fires when the cost gate agrees. On four rows it does not agree: there is
# no amount of factorization that pays for itself on a table this size, and the
# gate exists because firing regardless is a measured loss (FINDINGS F16).
statement ok
SET factorize_mode = 'auto';

query II
EXPLAIN SELECT count(*) FROM r, s WHERE r.x = s.x;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

query I
SELECT count(*) FROM r, s WHERE r.x = s.x;
----
4

statement ok
SET factorize_mode = 'off';

query II
EXPLAIN SELECT count(*) FROM r, s WHERE r.x = s.x;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

query I
SELECT count(*) FROM r, s WHERE r.x = s.x;
----
4

#-----------------------------------------------------------------------------
# Memory. The rule replaced a plan DuckDB could have run, so a representation
# that does not fit has to cost time, not the answer.
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE chain1 AS SELECT i % 50 AS s, i % 50 AS d FROM range(5000) t(i);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM chain1 p, chain1 q, chain1 r WHERE p.d = q.s AND q.d = r.s;
----
50000000

statement ok
SET memory_limit = '10MB';

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM chain1 p, chain1 q, chain1 r WHERE p.d = q.s AND q.d = r.s;
----
50000000

statement ok
SET memory_limit = '1GB';

statement ok
SET factorize_mode = 'off';

#-----------------------------------------------------------------------------
# The gate. It is the load-bearing part of AUTO, not a safety wrapper: fired
# unconditionally the engine is a measured loss, because the benefit is
# concentrated in a minority of queries rather than spread across them.
#-----------------------------------------------------------------------------

# Multiplicity 100 on every key, so the three-way join is a million tuples per
# key over 80 keys: eighty million from twenty-four thousand rows.
#
# That ratio is the point. The re-fitted model says DuckDB counts a result tuple
# in under a microsecond, so factorizing only pays when the result is on the
# order of a thousand times the input -- which is exactly the regime the paper
# is about, and not a regime a small test table reaches by accident.
statement ok
CREATE TABLE big_a AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
CREATE TABLE big_b AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
CREATE TABLE big_c AS SELECT i % 80 AS k FROM range(8000) t(i);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
80000000

statement ok
SET factorize_mode = 'auto';

# Big enough for the gate to take the bet, and the answer is the same either way
# -- which is the only property that matters when the gate is wrong.
query II
EXPLAIN SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
physical_plan	<REGEX>:.*FACTORIZED.*

query I
SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
80000000

# The margin is a knob, and turning it up far enough declines everything.
statement ok
SET factorize_min_gain = 1000000;

query II
EXPLAIN SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
physical_plan	<!REGEX>:.*FACTORIZED.*

query I
SELECT count(*) FROM big_a, big_b, big_c WHERE big_a.k = big_b.k AND big_b.k = big_c.k;
----
80000000

statement ok
RESET factorize_min_gain;

# FORCE ignores the gate by definition: it fires on the four-row table the gate
# turned down above.
statement ok
SET factorize_mode = 'force';

query II
EXPLAIN SELECT count(*) FROM r, s WHERE r.x = s.x;
----
physical_plan	<REGEX>:.*FACTORIZED.*

statement ok
SET factorize_mode = 'off';

#-----------------------------------------------------------------------------
# Thread-count invariance. The work is divided by hashing the join key into one
# bucket per thread, so the answer cannot depend on how many threads ran -- the
# partition is the same partition however it is dealt out. That is the property
# the paper's shared-representation parallelism has to establish by locking
# discipline, and this design gets by construction.
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE par_a AS SELECT i % 400 AS k FROM range(4000) t(i);

statement ok
CREATE TABLE par_b AS SELECT i % 400 AS k FROM range(4000) t(i);

statement ok
CREATE TABLE par_c AS SELECT i % 400 AS k FROM range(4000) t(i);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM par_a, par_b, par_c WHERE par_a.k = par_b.k AND par_b.k = par_c.k;
----
400000

statement ok
SET factorize_mode = 'force';

statement ok
SET threads = 1;

query I
SELECT count(*) FROM par_a, par_b, par_c WHERE par_a.k = par_b.k AND par_b.k = par_c.k;
----
400000

statement ok
SET threads = 2;

query I
SELECT count(*) FROM par_a, par_b, par_c WHERE par_a.k = par_b.k AND par_b.k = par_c.k;
----
400000

statement ok
SET threads = 4;

query I
SELECT count(*) FROM par_a, par_b, par_c WHERE par_a.k = par_b.k AND par_b.k = par_c.k;
----
400000

statement ok
SET threads = 7;

query I
SELECT count(*) FROM par_a, par_b, par_c WHERE par_a.k = par_b.k AND par_b.k = par_c.k;
----
400000

# A relation whose key no thread's bucket can split -- one value, every row --
# still has to come out right: skew is the case where slicing does the least,
# not the case where it may be wrong.
statement ok
CREATE TABLE skewed AS SELECT 1 AS k FROM range(500) t(i);

statement ok
SET factorize_mode = 'off';

query I
SELECT count(*) FROM skewed x, skewed y WHERE x.k = y.k;
----
250000

statement ok
SET factorize_mode = 'force';

query I
SELECT count(*) FROM skewed x, skewed y WHERE x.k = y.k;
----
250000

statement ok
RESET threads;

statement ok
SET factorize_mode = 'off';

#-----------------------------------------------------------------------------
# GROUP BY. The grouping key sits at the top of the f-tree, so each root record
# is a group and the tuples under it are a number the representation already
# knows -- no tuple is enumerated to count them (plan §10.1).
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE g_left AS SELECT * FROM (VALUES (1), (1), (2), (3)) t(k);

statement ok
CREATE TABLE g_right AS SELECT * FROM (VALUES (1), (2), (2), (4)) t(k);

statement ok
SET factorize_mode = 'off';

# k=1: 2x1, k=2: 1x2. k=3 and k=4 join with nothing and are not groups.
query II
SELECT g_left.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k GROUP BY g_left.k ORDER BY 1;
----
1	2
2	2

statement ok
SET factorize_mode = 'force';

# DuckDB narrows the group key before the aggregate and widens it after, and
# reproducing that transformation here would tie this rule to an internal
# function. With that pass disabled the rule takes the query over.
statement ok
SET disabled_optimizers = 'compressed_materialization';

query II
SELECT g_left.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k GROUP BY g_left.k ORDER BY 1;
----
1	2
2	2

query II
EXPLAIN SELECT g_left.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k GROUP BY g_left.k;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# The groups have to sum to the ungrouped count, or one of the two is wrong.
query I
SELECT sum(c) FROM (SELECT g_left.k, count(*) AS c FROM g_left, g_right
                     WHERE g_left.k = g_right.k GROUP BY g_left.k) t;
----
4

# Grouping on the other side of the equality names the same groups, because an
# equi-join's keys are equal by definition.
query II
SELECT g_right.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k GROUP BY g_right.k ORDER BY 1;
----
1	2
2	2

# A grouping column that is not a join column is added to the scan, the same way
# a summed column is: it changes no count, but the answer has one row per value
# of it, so its values have to be there.
statement ok
CREATE TABLE g_wide AS SELECT * FROM (VALUES (1, 7), (2, 8)) t(k, other);

query II
SELECT g_wide.other, count(*) FROM g_wide, g_right WHERE g_wide.k = g_right.k GROUP BY g_wide.other ORDER BY 1;
----
7	1
8	2

query II
EXPLAIN SELECT g_wide.other, count(*) FROM g_wide, g_right WHERE g_wide.k = g_right.k GROUP BY g_wide.other;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# Two grouping keys. Here they are the two sides of one equality, so they are
# the same equivalence class and name the same groups twice over.
query III
SELECT g_left.k, g_right.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k
 GROUP BY g_left.k, g_right.k ORDER BY 1;
----
1	1	2
2	2	2

query II
EXPLAIN SELECT g_left.k, g_right.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k
 GROUP BY g_left.k, g_right.k;
----
physical_plan	<REGEX>:.*FACTORIZED.*

#-----------------------------------------------------------------------------
# Grouping keys scattered across independent sibling branches. Plan §10.1
# expected this to be *declined*: several keys in different branches need the
# cross product of those branches. But that cross product is what the
# representation is made of -- siblings are independent, which is the premise --
# so each branch is grouped on its own and the branches are combined.
#
# This is not an exotic shape. A star schema grouped on columns from two
# dimension tables produces exactly it, which is why lifting the restriction
# took the rule from 2 of 99 TPC-DS queries to 49.
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE x_hub AS SELECT * FROM (VALUES (1), (2)) t(k);

statement ok
CREATE TABLE x_arm1 AS SELECT * FROM (VALUES (1, 100), (1, 200), (2, 300)) t(k, p);

statement ok
CREATE TABLE x_arm2 AS SELECT * FROM (VALUES (1, 7), (2, 8), (2, 9)) t(k, q);

statement ok
SET factorize_mode = 'off';

# p and q are payload columns of two different branches under the hub key, and
# neither is a join column. k=1 pairs {100,200} with {7}; k=2 pairs {300} with
# {8,9}.
query III
SELECT x_arm1.p, x_arm2.q, count(*) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2 ORDER BY 1, 2;
----
100	7	1
200	7	1
300	8	1
300	9	1

statement ok
SET factorize_mode = 'force';

query III
SELECT x_arm1.p, x_arm2.q, count(*) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2 ORDER BY 1, 2;
----
100	7	1
200	7	1
300	8	1
300	9	1

query II
EXPLAIN SELECT x_arm1.p, x_arm2.q, count(*) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# Three keys, one of them the join key the two branches hang from -- so the
# groups split by a value at the root and by a value in each branch at once.
query IIII
SELECT x_hub.k, x_arm1.p, x_arm2.q, count(*) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2, 3 ORDER BY 1, 2, 3;
----
1	100	7	1
1	200	7	1
2	300	8	1
2	300	9	1

# The groups have to sum to the ungrouped count, or one of the two is wrong.
query I
SELECT sum(c) FROM (SELECT x_arm1.p, x_arm2.q, count(*) AS c FROM x_hub, x_arm1, x_arm2
                     WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2) t;
----
4

# Grouping on one branch while summing the other: the sum has to be weighted by
# how many tuples the branches it is not in make (§4.5), and the grouping keys
# change what "the other branches" means for each group.
statement ok
SET factorize_mode = 'off';

query II
SELECT x_arm2.q, sum(x_arm1.p) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1 ORDER BY 1;
----
7	300
8	300
9	300

statement ok
SET factorize_mode = 'force';

query II
SELECT x_arm2.q, sum(x_arm1.p) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1 ORDER BY 1;
----
7	300
8	300
9	300

query II
EXPLAIN SELECT x_arm2.q, sum(x_arm1.p) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# Two keys from one relation, one of them a join column and one not.
query III
SELECT x_arm1.k, x_arm1.p, count(*) FROM x_hub, x_arm1, x_arm2
 WHERE x_hub.k = x_arm1.k AND x_hub.k = x_arm2.k GROUP BY 1, 2 ORDER BY 1, 2;
----
1	100	1
1	200	1
2	300	2

# A grouping column of a type the representation cannot carry is a decline, not
# a wrong answer: the key has to come back out as itself.
statement ok
CREATE TABLE x_text AS SELECT * FROM (VALUES (1, 'a'), (2, 'b')) t(k, name);

query II
SELECT x_text.name, count(*) FROM x_hub, x_text WHERE x_hub.k = x_text.k GROUP BY 1 ORDER BY 1;
----
a	1
b	1

#-----------------------------------------------------------------------------
# NULL, and rows that are not there. Four bugs found by asking what happens to a
# row the scan drops, all of them answers that were wrong rather than absent.
#-----------------------------------------------------------------------------

# The scan reads `columns` and then `filter_columns`, so a filter-only column
# sits at position columns.size()+i -- a position derived from columns.size()
# and therefore invalidated by appending to it. The summed column is such an
# append. Before the fix this returned 700: the filter `w > 5` was applied to
# whatever occupied position 1, which the append had made `v`.
#
# It needs BOTH a filter on a column the region does not otherwise read AND an
# aggregate that appends one. The count(*) twin below has the same filter and no
# append, and was always right -- which is why no existing test caught this.
statement ok
CREATE TABLE n_p AS SELECT * FROM (VALUES (1, 100, 9), (1, 200, 1), (2, 400, 9)) t(k, v, w);

statement ok
CREATE TABLE n_q AS SELECT * FROM (VALUES (1), (2)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT sum(n_p.v) FROM n_p, n_q WHERE n_p.k = n_q.k AND n_p.w > 5;
----
500

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(n_p.v) FROM n_p, n_q WHERE n_p.k = n_q.k AND n_p.w > 5;
----
500

query II
EXPLAIN SELECT sum(n_p.v) FROM n_p, n_q WHERE n_p.k = n_q.k AND n_p.w > 5;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# The twin with no appended column, which never had the bug. Its job is to say
# that the append is what breaks it, not the filter.
query I
SELECT count(*) FROM n_p, n_q WHERE n_p.k = n_q.k AND n_p.w > 5;
----
2

# sum over no rows is NULL, not zero, and the fold cannot tell the two apart --
# an empty join and a join of zeroes both total zero. The ranges overlap on
# purpose: with disjoint ones DuckDB proves the join empty and plants an
# EMPTY_RESULT, which the rule declines, and the case goes untested.
statement ok
CREATE TABLE n_m AS SELECT * FROM (VALUES (1, 5), (3, 7)) t(k, v);

statement ok
CREATE TABLE n_n AS SELECT * FROM (VALUES (2), (4)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT sum(n_m.v) FROM n_m, n_n WHERE n_m.k = n_n.k;
----
NULL

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(n_m.v) FROM n_m, n_n WHERE n_m.k = n_n.k;
----
NULL

# Same answer by a different route: every row that could contribute is dropped
# for holding a NULL in the summed column, so nothing is summed.
statement ok
CREATE TABLE n_c AS SELECT * FROM (VALUES (1, NULL)) t(k, v);

statement ok
CREATE TABLE n_d AS SELECT * FROM (VALUES (1), (1)) t(k);

statement ok
SET factorize_mode = 'off';

query I
SELECT sum(n_c.v) FROM n_c, n_d WHERE n_c.k = n_d.k;
----
NULL

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(n_c.v) FROM n_c, n_d WHERE n_c.k = n_d.k;
----
NULL

# A row dropped for a NULL is invisible in an ungrouped sum -- it contributes
# NULL either way -- but grouped it takes a whole group with it. g=1's only row
# is NULL in v, so before the fix the answer had one row where SQL has two.
statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE n_r AS SELECT * FROM (VALUES (1, 1, NULL), (2, 2, 5)) t(k, g, v);

statement ok
CREATE TABLE n_s AS SELECT * FROM (VALUES (1), (2)) t(k);

statement ok
SET factorize_mode = 'off';

query II
SELECT n_r.g, sum(n_r.v) FROM n_r, n_s WHERE n_r.k = n_s.k GROUP BY n_r.g ORDER BY 1;
----
1	NULL
2	5

statement ok
SET factorize_mode = 'force';

query II
SELECT n_r.g, sum(n_r.v) FROM n_r, n_s WHERE n_r.k = n_s.k GROUP BY n_r.g ORDER BY 1;
----
1	NULL
2	5

# A grouping column that may be NULL is its own group, which no key slot can
# hold, so the rule declines rather than answer with a row missing. Declining is
# checked by the answer being right: a takeover here would lose the NULL group.
query II
SELECT n_r.v, count(*) FROM n_r, n_s WHERE n_r.k = n_s.k GROUP BY n_r.v ORDER BY 1;
----
5	1
NULL	1

statement ok
RESET disabled_optimizers;

# With the compression pass back on the rule declines rather than guessing, and
# the answer is unchanged.
query II
SELECT g_left.k, count(*) FROM g_left, g_right WHERE g_left.k = g_right.k GROUP BY g_left.k ORDER BY 1;
----
1	2
2	2

statement ok
SET factorize_mode = 'off';

#-----------------------------------------------------------------------------
# sum(). The aggregate that actually appears in analytics SQL: across the 99
# TPC-DS optimized plans it occurs 193 times over inner-only join graphs against
# 24 for count(*). Counting multiplies; summing weights a slot's values by how
# many tuples the other slots make, which is the semiring product of §4.5.
#-----------------------------------------------------------------------------

statement ok
CREATE TABLE s_hub AS SELECT * FROM (VALUES (1), (2)) t(k);

statement ok
CREATE TABLE s_arm AS SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) t(k, v);

statement ok
CREATE TABLE s_other AS SELECT * FROM (VALUES (1), (1), (2)) t(k);

statement ok
SET factorize_mode = 'off';

# s_arm's values are each seen once per matching s_other row: k=1 has two such
# rows, so 10 and 20 count twice; k=2 has one, so 30 counts once.
query I
SELECT sum(s_arm.v) FROM s_hub, s_arm, s_other
 WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k;
----
90

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(s_arm.v) FROM s_hub, s_arm, s_other
 WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k;
----
90

query II
EXPLAIN SELECT sum(s_arm.v) FROM s_hub, s_arm, s_other
 WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k;
----
physical_plan	<REGEX>:.*FACTORIZED.*

# Summing a join key works too, and is the case where the value sits at the top
# of the tree rather than in a branch.
statement ok
SET factorize_mode = 'off';

query I
SELECT sum(s_hub.k) FROM s_hub, s_arm, s_other WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k;
----
6

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(s_hub.k) FROM s_hub, s_arm, s_other WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k;
----
6

# sum with GROUP BY: both generalisations at once.
statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
SET factorize_mode = 'off';

query II
SELECT s_hub.k, sum(s_arm.v) FROM s_hub, s_arm, s_other
 WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k GROUP BY s_hub.k ORDER BY 1;
----
1	60
2	30

statement ok
SET factorize_mode = 'force';

query II
SELECT s_hub.k, sum(s_arm.v) FROM s_hub, s_arm, s_other
 WHERE s_hub.k = s_arm.k AND s_hub.k = s_other.k GROUP BY s_hub.k ORDER BY 1;
----
1	60
2	30

statement ok
RESET disabled_optimizers;

# A row that joins with nothing contributes nothing to the sum.
statement ok
CREATE TABLE s_lonely AS SELECT * FROM (VALUES (1, 5), (99, 100000)) t(k, v);

statement ok
SET factorize_mode = 'off';

query I
SELECT sum(s_lonely.v) FROM s_lonely, s_hub WHERE s_lonely.k = s_hub.k;
----
5

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(s_lonely.v) FROM s_lonely, s_hub WHERE s_lonely.k = s_hub.k;
----
5

# DECIMAL is summed, not declined (DECISIONS D10 committed v1 to integer and
# DECIMAL). Its storage is an integer times a power of ten, so the stored
# integers are what the fold adds and the scale is reapplied once, to the total
# -- and on TPC-DS this is where sums actually live: 31 queries whose only
# matchable aggregate sums a DECIMAL, against 13 reachable without it.
statement ok
CREATE TABLE s_money AS SELECT * FROM (VALUES (1, 1.50), (2, 2.25)) t(k, amount);

statement ok
SET factorize_mode = 'off';

query I
SELECT sum(s_money.amount) FROM s_money, s_hub WHERE s_money.k = s_hub.k;
----
3.75

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(s_money.amount) FROM s_money, s_hub WHERE s_money.k = s_hub.k;
----
3.75

# ... and the type comes back as DuckDB's own: sum(DECIMAL(p,s)) is
# DECIMAL(38,s) whatever p was, so operators above bind against that.
query I
SELECT typeof(sum(s_money.amount)) FROM s_money, s_hub WHERE s_money.k = s_hub.k;
----
DECIMAL(38,2)

# A DECIMAL multiplied out by the join: the scale must not be applied per row.
statement ok
SET factorize_mode = 'off';

query I
SELECT sum(s_money.amount) FROM s_money, s_hub, s_other
 WHERE s_money.k = s_hub.k AND s_money.k = s_other.k;
----
5.25

statement ok
SET factorize_mode = 'force';

query I
SELECT sum(s_money.amount) FROM s_money, s_hub, s_other
 WHERE s_money.k = s_hub.k AND s_money.k = s_other.k;
----
5.25

# Grouped, so the scale is reapplied once per group rather than once per query.
statement ok
SET disabled_optimizers = 'compressed_materialization';

query II
SELECT s_money.k, sum(s_money.amount) FROM s_money, s_hub WHERE s_money.k = s_hub.k
 GROUP BY s_money.k ORDER BY 1;
----
1	1.50
2	2.25

statement ok
RESET disabled_optimizers;

# Floating point stays declined, and on purpose: reassociation makes the answer
# depend on the order it was summed in, and 'auto' must equal 'off' (D10).
statement ok
CREATE TABLE s_float AS SELECT * FROM (VALUES (1, 1.5::DOUBLE), (2, 2.25::DOUBLE)) t(k, amount);

query I
SELECT sum(s_float.amount) FROM s_float, s_hub WHERE s_float.k = s_hub.k;
----
3.75

# sum of a computed expression is not a fold over a stored column.
query I
SELECT sum(s_arm.v * 2) FROM s_hub, s_arm WHERE s_hub.k = s_arm.k;
----
120

statement ok
SET factorize_mode = 'off';
