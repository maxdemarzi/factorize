# name: test/sql/factorized_count.test
# description: Phase 2 -- factorized_count() over real DuckDB storage
# group: [sql]

require factorize

# A three-relation star on one key. Every value of x appears 10 times in each
# relation, so the join is 10*10*10 = 1000 per value across 10 values.
statement ok
CREATE TABLE a AS SELECT i % 10 AS s, i AS d FROM range(100) t(i);

statement ok
CREATE TABLE b AS SELECT i % 10 AS s, i AS d FROM range(100) t(i);

statement ok
CREATE TABLE c AS SELECT i % 10 AS s, i AS d FROM range(100) t(i);

# The answer must equal what DuckDB computes for the same join.
query I
SELECT count(*) FROM a, b, c WHERE a.s = b.s AND b.s = c.s;
----
10000

query I
SELECT * FROM factorized_count(['a', 'b', 'c'], ['a.s = b.s', 'b.s = c.s']);
----
10000

# A chain, where the second join is on the other column. Nothing is
# independent here, so this is the shape factorization does not help -- but it
# still has to be right. a.d is 0..99 and b.s is i%10, so the ten a-rows with
# d < 10 each match ten b-rows.
query I
SELECT count(*) FROM a, b WHERE a.d = b.s;
----
100

query I
SELECT * FROM factorized_count(['a', 'b'], ['a.d = b.s']);
----
100

# Self-joins are distinguished by alias, exactly as SQL does it.
query I
SELECT count(*) FROM a x, a y WHERE x.s = y.s;
----
1000

query I
SELECT * FROM factorized_count(['a x', 'a y'], ['x.s = y.s']);
----
1000

query I
SELECT * FROM factorized_count(['a AS x', 'a AS y'], ['x.s = y.s']);
----
1000

# Equality propagation: a.s = b.s AND a.s = c.s names `a` twice, while the
# star above names `b` in the middle. Both describe the same equivalence class
# and must give the same answer -- if the planner attached relations beneath
# whichever relation the predicate happened to name, these would differ.
query I
SELECT * FROM factorized_count(['a', 'b', 'c'], ['a.s = b.s', 'a.s = c.s']);
----
10000

# An empty join result.
statement ok
CREATE TABLE empty_side AS SELECT 999 AS s, 1 AS d;

query I
SELECT * FROM factorized_count(['a', 'empty_side'], ['a.s = empty_side.s']);
----
0

# NULL keys never match, so they cannot contribute to an inner join's count.
statement ok
CREATE TABLE nullable AS SELECT * FROM (VALUES (1, 1), (NULL, 2), (1, 3)) v(s, d);

query I
SELECT count(*) FROM a, nullable WHERE a.s = nullable.s;
----
20

query I
SELECT * FROM factorized_count(['a', 'nullable'], ['a.s = nullable.s']);
----
20

# A relation contributing TWO join columns, with NULLs in different rows of
# different columns. This is the composite-key shape that exposed a real bug:
# NULLs used to be filtered independently per column, which desynchronizes a
# relation's columns from each other. Filtering (NULL,2) out of column p but
# keeping it in column q, and symmetrically for (3,NULL), used to fabricate a
# row (p=3, q=2) that never existed in the source data. Correct behaviour
# drops a row from every column at once if any of its join columns is NULL:
# only (1,1) and (2,2) survive, each contributing 10*10 = 100 (a.s has 10
# rows per distinct value 0..9), for a total of 200 -- not the 300 the
# desynchronized version would compute by fabricating (3,2).
statement ok
CREATE TABLE composite AS SELECT * FROM (VALUES (1, 1), (NULL, 2), (3, NULL), (2, 2)) v(p, q);

query I
SELECT count(*) FROM a x, a y, composite WHERE x.s = composite.p AND y.s = composite.q;
----
200

query I
SELECT * FROM factorized_count(['a x', 'a y', 'composite'], ['x.s = composite.p', 'y.s = composite.q']);
----
200

# Wider integer types are accepted and compared by value.
statement ok
CREATE TABLE wide AS SELECT (i % 10)::BIGINT AS s, i::BIGINT AS d FROM range(100) t(i);

query I
SELECT * FROM factorized_count(['a', 'wide'], ['a.s = wide.s']);
----
1000

#
# Rejections. Each must name the specific problem: this function declines by
# design, and a decline that does not say why is undiagnosable.
#

statement error
SELECT * FROM factorized_count(['a'], ['a.s = a.s']);
----
at least two relations

statement error
SELECT * FROM factorized_count(['a', 'b'], ['a.s > b.s']);
----
not an equality

statement error
SELECT * FROM factorized_count(['a', 'b'], ['a.s = b.nonexistent']);
----
no column

statement error
SELECT * FROM factorized_count(['a', 'b'], ['a.s = nosuchrel.s']);
----
does not name a listed relation

statement error
SELECT * FROM factorized_count(['a', 'a'], ['a.s = a.s']);
----
duplicate relation

# A relation nothing joins to would be a cross product, not a join.
statement error
SELECT * FROM factorized_count(['a', 'b', 'c'], ['a.s = b.s']);
----
no join predicate

# Non-integer keys cannot be packed into an f-representation's fixed-width
# slots, and saying so by name beats failing inside the core.
statement ok
CREATE TABLE strings AS SELECT 'x' AS s, 1 AS d;

statement error
SELECT * FROM factorized_count(['a', 'strings'], ['a.s = strings.s']);
----
only integer keys

statement error
SELECT * FROM factorized_count(['a', 'nosuchtable'], ['a.s = nosuchtable.s']);
----
nosuchtable

# An f-representation that outgrows memory must fail the query, not the process.
# On the CE corpus an unbounded build was OOM-killed and took the whole DuckDB
# session with it; the engine is now capped by DuckDB's own memory_limit.
#
# This needs a shape where the *representation* is large, not merely the answer.
# A star over `a` will not do it -- that is the case factorization handles, and
# it stays at a few hundred records however big the count gets. A chain is the
# opposite: each level multiplies, so 5,000 rows over 50 key values materialise
# roughly half a million records.
statement ok
CREATE TABLE chainable AS SELECT i % 50 AS s, i % 50 AS d FROM range(5000) t(i);

statement ok
SET memory_limit = '10MB';

statement error
SELECT * FROM factorized_count(['chainable p', 'chainable q', 'chainable r'],
                               ['p.d = q.s', 'q.d = r.s']);
----
memory limit

statement ok
RESET memory_limit;

# ... and with room it answers: 5000 rows, each key value matching 100 rows at
# each of two further levels.
query I
SELECT count(*) FROM chainable p, chainable q, chainable r
 WHERE p.d = q.s AND q.d = r.s;
----
50000000

query I
SELECT * FROM factorized_count(['chainable p', 'chainable q', 'chainable r'],
                               ['p.d = q.s', 'q.d = r.s']);
----
50000000

# An empty relation empties the join. This used to crash rather than answer:
# DataTable::InitializeScan asserts on a table with no row groups at all, and
# nothing in the CE corpus is empty, so the scan path never met one.
statement ok
CREATE TABLE no_rows (s INTEGER, d INTEGER);

query I
SELECT * FROM factorized_count(['chainable p', 'no_rows q'], ['p.d = q.s']);
----
0

query I
SELECT count(*) FROM chainable p, no_rows q WHERE p.d = q.s;
----
0

# Rows the transaction has not committed yet are part of the answer too: the
# scan has to see local storage, not only what is on disk.
statement ok
BEGIN;

statement ok
INSERT INTO no_rows VALUES (1, 1), (1, 2);

query I
SELECT * FROM factorized_count(['chainable p', 'no_rows q'], ['p.d = q.s']);
----
200

query I
SELECT count(*) FROM chainable p, no_rows q WHERE p.d = q.s;
----
200

statement ok
ROLLBACK;
